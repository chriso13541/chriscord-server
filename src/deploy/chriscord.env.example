# Optional settings for the chriscord service.
# Copied to /etc/chriscord/chriscord.env by install.sh (only if it doesn't
# exist yet). After editing:  sudo systemctl restart chriscord

# Public IP address to offer for voice, for people connecting from outside
# your network (otherwise worked out automatically — usually not needed).
#CHRISCORD_PUBLIC_IP=203.0.113.10

# Advertise this IP for voice instead of the detected LAN address.
#CHRISCORD_ICE_IP=192.168.1.10

# Only use these network interfaces for voice (comma-separated).
#CHRISCORD_ICE_INTERFACES=eth0

# More detailed logs (default: info).
#RUST_LOG=chriscord_server=debug
